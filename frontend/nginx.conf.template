server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Encaminha tudo que comeca com /api para o backend. O host vem da
    # variavel de ambiente BACKEND_HOST (substituida na hora que o
    # container sobe - ver Dockerfile), pra funcionar tanto no Docker
    # Compose local/Hostinger (BACKEND_HOST=backend, resolvido pela rede
    # interna do Compose) quanto na Railway (BACKEND_HOST=<nome do
    # servico backend>.railway.internal) sem precisar mexer no arquivo.
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:8080/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Todo o resto vai para o React (SPA) - o try_files garante que
    # rotas como /financeiro funcionem mesmo em um F5 direto na URL.
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# Copie este arquivo para ".env" (mesma pasta) e preencha com valores reais
# antes de rodar "docker compose up". NUNCA envie o .env de verdade pro
# Git ou para qualquer lugar publico - ele tem as senhas do sistema.

# Banco de dados
DB_NAME=aracabeach
DB_USERNAME=aracabeach
DB_PASSWORD=defina-uma-senha-forte-para-o-banco
DB_ROOT_PASSWORD=defina-uma-senha-forte-para-o-root-do-mysql

# Autenticacao - gere uma chave longa e aleatoria (ex: openssl rand -base64 48)
JWT_SECRET=troque-por-uma-chave-bem-longa-e-aleatoria

# E-mail (opcional - notificacoes automaticas). Deixe em branco se nao for usar.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_ALERTAS=

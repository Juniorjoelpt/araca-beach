# Variaveis de ambiente opcionais - se nao definidas, os valores padrao do
# application.yml sao usados (localhost:3306, banco aracabeach, usuario root).
JWT_SECRET=defina-uma-chave-secreta-longa-e-aleatoria
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aracabeach
DB_USERNAME=root
DB_PASSWORD=sua-senha-do-mysql

# E-mail (notificacoes automaticas de reserva) - opcional.
# Se nao configurar, o sistema funciona normalmente, so nao envia e-mails
# (as tentativas de envio falham silenciosamente e ficam so no log).
# Exemplo usando Gmail: crie uma "senha de app" em
# https://myaccount.google.com/apppasswords (exige verificacao em 2 etapas
# ativada na conta) - NAO use a senha normal da sua conta Google aqui.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seuemail@gmail.com
MAIL_PASSWORD=senha-de-app-de-16-caracteres
